# ──────────────────────────────────────────────────────────
# Baba Flats — Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# Do NOT commit .env to version control — it may contain secrets.

# ╔═══════════════════════════════════════════════════════╗
# ║  Client (Vite — VITE_)  [LEGACY — removed at cutover] ║
# ╚═══════════════════════════════════════════════════════╝
# These serve the legacy Vite app only and are deleted at the Next cutover
# (Task 16). For the Next.js app use the NEXT_PUBLIC_* section below.

# Base URL of the API server the frontend talks to.
# In development this is typically the local Express server.
VITE_API_ORIGIN=http://localhost:8787

# Studio editor password (must match STUDIO_PASSWORD below).
# Required for the Studio UI to function — leave empty to see a config error.
VITE_STUDIO_PASSWORD=changeme

# Timeout (in milliseconds) for API requests made by the frontend.
VITE_API_TIMEOUT_MS=10000

# ╔═══════════════════════════════════════════════════════╗
# ║  Client (Next.js — prefixed with NEXT_PUBLIC_)       ║
# ╚═══════════════════════════════════════════════════════╝
# These are inlined into the client bundle at build time. Do NOT put secrets
# here — anything NEXT_PUBLIC_* is shipped to the browser.

# Studio editor password used by the client to authenticate content draft/
# publish calls (sent as the `x-studio-password` header).
# IMPORTANT: this MUST match the server-side STUDIO_PASSWORD below, otherwise
# the Studio's save/publish requests are rejected with 401.
NEXT_PUBLIC_STUDIO_PASSWORD=changeme

# Origin the client uses for API calls. Leave empty for the unified Next.js app
# (the /api/* route handlers are same-origin). Set only to target a remote API.
NEXT_PUBLIC_API_ORIGIN=

# Timeout (in milliseconds) for API requests made by the frontend.
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Public base URL of the deployed site. Used (server-side) for SEO:
# metadataBase — resolves canonical links + Open Graph image URLs to absolute
# URLs — plus the robots.txt sitemap reference and the sitemap.xml entries.
# Defaults to https://babaflats.com when unset.
NEXT_PUBLIC_SITE_URL=https://babaflats.com

# ╔═══════════════════════════════════════════════════════╗
# ║  Server (Express)                                    ║
# ╚═══════════════════════════════════════════════════════╝

# Port the API server listens on.
API_PORT=8787

# Studio editor password — REQUIRED. The server will refuse to start without it.
# Must match VITE_STUDIO_PASSWORD so the client can authenticate.
STUDIO_PASSWORD=changeme

# Node environment. Set to "production" in deployed environments
# to hide verbose error details in API responses.
# NODE_ENV=production

# ╔═══════════════════════════════════════════════════════╗
# ║  SMTP (server-side email for the contact form)       ║
# ╚═══════════════════════════════════════════════════════╝

# Hostname of the SMTP server (e.g., smtp.gmail.com, smtp.sendgrid.net).
SMTP_HOST=

# SMTP port. Common values: 587 (STARTTLS), 465 (SSL), 25 (unencrypted).
SMTP_PORT=587

# Use a direct TLS connection (port 465). Set to "true" or "false".
SMTP_SECURE=false

# SMTP authentication credentials.
SMTP_USER=
SMTP_PASS=

# "From" address shown on outgoing emails (e.g., noreply@example.com).
SMTP_FROM=

# Recipient address for contact-form submissions (e.g., hello@example.com).
SMTP_TO=


# ╔═══════════════════════════════════════════════════════╗
# ║  Contact lead capture (Next.js server route handlers)║
# ╚═══════════════════════════════════════════════════════╝
# Used by app/api/contact (POST). Every valid submission is persisted to
# .data/contact-submissions.json first, then delivered to whichever channels
# below are configured. With no channel configured the route still returns 200
# and saves the lead locally.

# Recipient inbox for contact-form leads (used by both the SMTP email and the
# Google Apps Script email). Defaults to Contact@babaflats.com when unset.
CONTACT_TO_EMAIL=Contact@babaflats.com

# Google Apps Script Web App URL for lead delivery (appends a Google Sheet row
# and emails the lead). Deploy docs/apps-script/contact-endpoint.gs and paste
# the resulting /exec URL here. Leave empty to disable the Apps Script channel.
CONTACT_APPS_SCRIPT_URL=

# The SMTP_* variables above also drive the Next contact route's optional email
# channel (nodemailer). Set SMTP_HOST and SMTP_PORT to enable it; leave empty to
# disable. Email is sent to CONTACT_TO_EMAIL with replyTo set to the submitter.


# ╔═══════════════════════════════════════════════════════╗
# ║  Google Reviews (home page reviews section)          ║
# ╚═══════════════════════════════════════════════════════╝
# The reviews section on the home page can source Google reviews two ways. It
# hides itself when neither is configured.
#
# (B) Optional — live via the Google Places API (server-side, cached 1h). Needs
#     a Google Cloud key with the Places API enabled + your Place ID. Used only
#     when the embed URL above is empty. The key is server-only (never shipped
#     to the browser).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=


# ╔═══════════════════════════════════════════════════════╗
# ║  Studio publish → GitHub (production content sync)    ║
# ╚═══════════════════════════════════════════════════════╝
# In production (Vercel), the serverless filesystem is read-only/ephemeral, so a
# Studio "Publish" cannot write public/content.json to disk. Instead it commits
# the file to this repo via the GitHub API, which triggers a redeploy that
# serves the new content. Uploaded media (images/videos) is likewise committed
# to public/uploads and served from GitHub's raw CDN (live immediately, no
# redeploy). Leave these empty for local development — the Studio then writes
# public/content.json and public/uploads to disk as before.
#
# GITHUB_TOKEN: a fine-grained Personal Access Token scoped to THIS repo with
#   "Contents: Read and write" permission. Server-only secret — never exposed to
#   the browser. Store it in Vercel Project Settings → Environment Variables.
# GITHUB_REPO: target repository as "owner/name" (e.g. shubhtoy/RealtorSiteTest-pages).
# GITHUB_BRANCH: branch Vercel deploys from; commits land here (default: main).
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main


# ╔═══════════════════════════════════════════════════════╗
# ║  Google Sheets lead funnel (contact form → Sheet)     ║
# ╚═══════════════════════════════════════════════════════╝
# Optional. When configured, every contact submission is appended as a row to a
# Google Sheet via the standard `google-spreadsheet` client + a Google Cloud
# service account. Leave empty to disable this channel.
#
# Setup:
#   1. Google Cloud Console → create a project → enable the Google Sheets API.
#   2. Create a Service Account; under Keys, add a JSON key and download it.
#   3. Share your Google Sheet with the service account's client email as Editor.
#   4. Copy the sheet ID from its URL:
#      https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
#
# The recipient email + subject for the email channel are edited in the Studio
# (Contact → integrations), not here. Only transport secrets live in env.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file. Keep the literal \n escapes
# (the app converts them to real newlines); wrap the whole value in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
