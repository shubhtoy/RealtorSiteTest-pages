{
  "name": "baba-flats-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Modern apartment website for Baba Flats - Built with Next.js + React + TypeScript",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "preview": "next start",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "media:optimize": "node scripts/optimize-media.mjs",
    "media:optimize:images": "node scripts/optimize-media.mjs --images",
    "media:optimize:uploads": "node scripts/optimize-media.mjs --uploads",
    "media:optimize:videos": "node scripts/optimize-media.mjs --videos",
    "clean": "rm -rf dist .next .turbo node_modules/.cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "nextjs",
    "typescript",
    "tailwindcss",
    "apartment",
    "real-estate"
  ],
  "author": "Baba Flats",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@puckeditor/core": "^0.21.1",
    "@tabler/icons-react": "^3.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "16.2.10",
    "nodemailer": "^8.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intersection-observer": "^10.0.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.0.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
