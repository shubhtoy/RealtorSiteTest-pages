{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,global-error,not-found,route,template,default,sitemap,robots,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}",
    "next.config.ts",
    "src/**/*.{ts,tsx}"
  ],
  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
  "ignore": ["scripts/**", "public/**"],
  "ignoreDependencies": ["server-only", "shadcn"]
}
