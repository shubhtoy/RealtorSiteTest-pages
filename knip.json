{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,global-error,not-found,route,template,default,sitemap,robots,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}",
    "next.config.ts",
    "server/index.mjs"
  ],
  "project": ["app/**/*.{ts,tsx}", "server/**/*.{mjs,js}"],
  "ignore": [
    "src/**",
    "scripts/**",
    "public/**",
    "vite.config.ts",
    "tsconfig.vite.json",
    "tsconfig.node.json"
  ],
  "ignoreBinaries": ["vite"],
  "ignoreDependencies": [
    "server-only",
    "@base-ui/react",
    "@fontsource-variable/geist",
    "@puckeditor/core",
    "@radix-ui/react-accordion",
    "@radix-ui/react-tabs",
    "@tabler/icons-react",
    "class-variance-authority",
    "clsx",
    "embla-carousel-autoplay",
    "embla-carousel-fade",
    "embla-carousel-react",
    "lucide-react",
    "motion",
    "react-countup",
    "react-intersection-observer",
    "react-photo-album",
    "react-router-dom",
    "react-scroll-parallax",
    "sonner",
    "tailwind-merge",
    "tw-animate-css",
    "yet-another-react-lightbox",
    "@fast-check/vitest",
    "fast-check",
    "shadcn"
  ]
}
